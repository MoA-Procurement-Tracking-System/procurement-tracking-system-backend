NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/procurement_tracking?schema=public"
REDIS_URL="redis://localhost:6379"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
LOG_LEVEL=info

SESSION_COOKIE_NAME="moa_session"
SESSION_HOURS=8
REMEMBER_SESSION_DAYS=30
PASSWORD_CHANGE_SESSION_MINUTES=15
PASSWORD_RESET_MINUTES=30
USER_INVITATION_HOURS=72
TEMP_PASSWORD_HOURS=72
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Configure all three values together. Keep the API token server-side only.
MAILERSEND_API_TOKEN=""
MAILERSEND_FROM_EMAIL=""
MAILERSEND_FROM_NAME="MoA Procurement Tracking System"

# Reserved for the Ministry email server. Keep commented while MailerSend is active.
# PASSWORD_RESET_WEBHOOK_URL=""
# USER_INVITATION_WEBHOOK_URL=""

BOOTSTRAP_ADMIN_EMAIL="admin@moa.gov.et"
BOOTSTRAP_ADMIN_NAME="System Administrator"
# Leave blank to generate a strong one-time password and print it once.
BOOTSTRAP_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Backup configuration
# ---------------------------------------------------------------------------
# Set to true on the production server to enable the monthly automated backup.
# Leave false (default) in development.
BACKUP_ENABLED=false
#
# Once IT confirms how the second server is accessible, set this to:
#   Option A (mounted share): /mnt/backup-server/procurement
#   Option B (rsync target):  backupuser@192.168.1.50:/backups/procurement
# BACKUP_REMOTE_PATH=""
