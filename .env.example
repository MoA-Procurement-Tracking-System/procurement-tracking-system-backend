NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/procurement?schema=public
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=moa_session
SESSION_HOURS=8
REMEMBER_SESSION_DAYS=30
PASSWORD_CHANGE_SESSION_MINUTES=15
PASSWORD_RESET_MINUTES=30
TEMP_PASSWORD_HOURS=72
USER_INVITATION_HOURS=72
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BOOTSTRAP_ADMIN_EMAIL=admin@moa.gov.et
BOOTSTRAP_ADMIN_NAME=System Administrator
# Leave blank to generate a strong one-time password and print it once.
BOOTSTRAP_ADMIN_PASSWORD=

# Active transactional email provider. Keep the token server-side and use a
# lowercase sender address on a domain verified in MailerSend.
MAILERSEND_API_TOKEN=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=MoA Procurement Tracking System

# Reserved for the future Ministry email service. The corresponding delivery
# blocks in auth.routes.ts are commented out while MailerSend is active.
PASSWORD_RESET_WEBHOOK_URL=
USER_INVITATION_WEBHOOK_URL=
# The reset webhook receives: { "to": "...", "resetUrl": "..." }.
# The invitation webhook receives:
# { "to": "...", "displayName": "...", "role": "...", "invitationUrl": "..." }.


CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

LOG_LEVEL=info
