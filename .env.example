NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/procurement?schema=public
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=moa_session
SESSION_HOURS=8
REMEMBER_SESSION_DAYS=30
PASSWORD_CHANGE_SESSION_MINUTES=15
PASSWORD_RESET_MINUTES=30
TEMP_PASSWORD_HOURS=72
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_WEBHOOK_URL=
BOOTSTRAP_ADMIN_EMAIL=admin@moa.gov.et
BOOTSTRAP_ADMIN_NAME=System Administrator
# Leave blank to generate a strong one-time password and print it once.
BOOTSTRAP_ADMIN_PASSWORD=

# The webhook receives: { "to": "...", "resetUrl": "..." }.
# Configure it to send reset links through the Ministry's email service.
