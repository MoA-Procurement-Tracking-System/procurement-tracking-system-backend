
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OFFICER
  DIRECTOR
  ADMIN
  ENDORSING_COMMITTEE
  MANAGEMENT_TEAM
  PROJECT_MANAGER
}

enum PlanStatus {
  Draft
  Submitted
  Approved
  Rejected
}

enum ActivityStatus {
  NotStarted
  InProgress
  Completed
  Delayed
  NotApplicable
  Cancelled
}

enum ImportStatus {
  Processing
  Completed
  CompletedWithErrors
  Failed
}
enum UserStatus{
 INVITED
 ACTIVE
 INACTIVE
 }
 enum SessionKind{
  PASSWORD_CHANGE
  AUTHENTICATED
  }
  


model User {
  id                   String   @id @default(uuid())
  username             String?  @unique
  displayname          String
  email                String   @unique
  passwordHash         String
  role                 Role
  status               UserStatus
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  sessions             Sessions[]
  
  mustChangePassword   Boolean
  tempPasswordExpiresAt DateTime?
  passwordChangedAt    DateTime?
  activities           Activity[]           @relation("ActivityOfficer")
  reviewedActivities   Activity[]           @relation("ActivityReviewer")
  auditLogs            AuditLog[]
  projectLinks         UserProject[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  failedLoginAttempts  Int                   @default(0)
  lockedUntil          DataTime?
  comments             Comment[]
  createdPlans         Plan[]               @relation("PlanCreator")
  approvedPlans        Plan[]               @relation("PlanApprover")
  rejectedPlans        Plan[]               @relation("PlanRejector")
  planReviews          PlanReview[]
  revisions            Revision[]
  uploadedDocuments    Document[]
  contractAmendments   ContractAmendment[]
  resolvedAlerts       Alert[]
  importBatches        ImportBatch[]
  invitationTokens     UserInvitationTokens[]

  @@index([role])
  @@index([isActive])
  mustChangePassword   Boolean  @default(false)
}
model Session {
  id         String      @id @default(uuid())
  tokenHash  String      @unique
  kind       SessionKind
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime    @default(now())
  createdAt  DateTime    @default(now())
  ipAddress  String?
  userAgent  String?
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
model UserInvitationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}


model Project {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  plans     Plan[]
  members   UserProject[]

  @@index([isActive])
}

model UserProject {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model LookupValue {
  id        String   @id @default(uuid())
  type      String
  code      String
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  activitiesByCategory      Activity[]          @relation("ActivityCategory")
  activitiesByMethod        Activity[]          @relation("ActivityMethod")
  activitiesBySector        Activity[]          @relation("ActivitySector")
  activitiesByRegion        Activity[]          @relation("ActivityRegion")
  activitiesByFundingSource Activity[]          @relation("ActivityFundingSource")
  activitiesByCurrency      Activity[]          @relation("ActivityCurrency")
  activitiesByReviewType    Activity[]          @relation("ActivityReviewType")
  activitiesByReviewStatus  Activity[]          @relation("ActivityReviewStatus")

  stageTemplatesByCategory  StageTemplate[]     @relation("StageTemplateCategory")
  stageTemplatesByMethod    StageTemplate[]     @relation("StageTemplateMethod")

  contractsByCurrency       Contract[]          @relation("ContractCurrency")
  contractsByRegion         Contract[]          @relation("ContractRegion")
  contractsByStatus         Contract[]          @relation("ContractStatus")

  securityTypes             ContractSecurity[]  @relation("SecurityType")
  securityStatuses          ContractSecurity[]  @relation("SecurityStatus")
  securityCurrencies        ContractSecurity[]  @relation("SecurityCurrency")

  milestoneStatuses         ContractMilestone[] @relation("MilestoneStatus")

  paymentTypes              Payment[]           @relation("PaymentType")
  paymentStatuses           Payment[]           @relation("PaymentStatus")

  alertEntityTypes          Alert[]             @relation("AlertEntityType")
  alertTypes                Alert[]             @relation("AlertType")
  alertSeverities           Alert[]             @relation("AlertSeverity")
  alertStatuses             Alert[]             @relation("AlertStatus")

  @@unique([type, code])
  @@index([type])
  @@index([isActive])
}

model Plan {
  id               String     @id @default(uuid())
  referenceNo      String     @unique
  name             String
  budgetYear       Int
  projectId        String?
  project          Project?   @relation(fields: [projectId], references: [id])
  description      String?
  status           PlanStatus @default(Draft)

  createdBy        String
  creator          User       @relation("PlanCreator", fields: [createdBy], references: [id])

  approvedById     String?
  approvedByUser   User?      @relation("PlanApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?

  rejectedById     String?
  rejectedByUser   User?      @relation("PlanRejector", fields: [rejectedById], references: [id])
  rejectedAt       DateTime?
  rejectionReason  String?

  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  activities       Activity[]
  reviews          PlanReview[]

  @@index([budgetYear])
  @@index([status])
  @@index([projectId])
  @@index([createdBy])
  @@index([approvedById])
  @@index([rejectedById])
}

model PlanReview {
  id           String   @id @default(uuid())
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewedById String
  reviewer     User     @relation(fields: [reviewedById], references: [id])
  notes        String
  createdAt    DateTime @default(now())

  @@index([planId])
  @@index([reviewedById])
}

model Activity {
  id               String         @id @default(uuid())
  referenceNumber  String         @unique

  planId           String
  plan             Plan           @relation(fields: [planId], references: [id])

  description      String

  categoryId       String
  category         LookupValue    @relation("ActivityCategory", fields: [categoryId], references: [id])

  methodId         String
  method           LookupValue    @relation("ActivityMethod", fields: [methodId], references: [id])

  sectorId         String
  sector           LookupValue    @relation("ActivitySector", fields: [sectorId], references: [id])

  regionId         String?
  region           LookupValue?   @relation("ActivityRegion", fields: [regionId], references: [id])

  fundingSourceId  String?
  fundingSource    LookupValue?   @relation("ActivityFundingSource", fields: [fundingSourceId], references: [id])

  currencyId       String
  currency         LookupValue    @relation("ActivityCurrency", fields: [currencyId], references: [id])

  reviewTypeId     String?
  reviewType       LookupValue?   @relation("ActivityReviewType", fields: [reviewTypeId], references: [id])

  reviewStatusId   String?
  reviewStatus     LookupValue?   @relation("ActivityReviewStatus", fields: [reviewStatusId], references: [id])

  reviewedById     String?
  reviewedByUser   User?          @relation("ActivityReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  reviewNotes      String?

  estimatedAmount  Decimal        @db.Decimal(14, 2)

  officerId        String
  officer          User           @relation("ActivityOfficer", fields: [officerId], references: [id])

  status           ActivityStatus @default(NotStarted)
  dueDate          DateTime?
  remarks          String?

  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  stages           ActivityStage[]
  contracts        Contract[]
  documents        Document[]

  @@index([planId])
  @@index([status])
  @@index([categoryId])
  @@index([methodId])
  @@index([sectorId])
  @@index([regionId])
  @@index([fundingSourceId])
  @@index([currencyId])
  @@index([officerId])
  @@index([reviewedById])
  @@index([reviewTypeId])
  @@index([reviewStatusId])
  @@index([dueDate])
  @@index([createdAt, id])
}

model ActivityStage {
  id           String         @id @default(uuid())
  activityId   String
  activity     Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)

  name         String
  order        Int

  baselineDate DateTime?
  currentDate  DateTime?
  actualDate   DateTime?

  status       ActivityStatus @default(NotStarted)
  remarks      String?

  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  documents    Document[]

  @@unique([activityId, order])
  @@index([activityId])
  @@index([status])
}

model StageTemplate {
  id           String      @id @default(uuid())

  categoryId   String
  category     LookupValue @relation("StageTemplateCategory", fields: [categoryId], references: [id])

  methodId     String
  method       LookupValue @relation("StageTemplateMethod", fields: [methodId], references: [id])

  stageName    String
  order        Int
  isMandatory  Boolean     @default(true)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  @@unique([categoryId, methodId, order])
  @@index([categoryId, methodId])
  @@index([isActive])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String   @unique
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  contracts Contract[]

  @@index([isActive])
}

model Contract {
  id             String      @id @default(uuid())
  contractNumber String      @unique

  activityId     String
  activity       Activity    @relation(fields: [activityId], references: [id])

  supplierId     String
  supplier       Supplier    @relation(fields: [supplierId], references: [id])

  originalAmount Decimal     @db.Decimal(14, 2)
  currentAmount  Decimal     @db.Decimal(14, 2)

  currencyId     String
  currency       LookupValue @relation("ContractCurrency", fields: [currencyId], references: [id])

  regionId       String?
  region         LookupValue? @relation("ContractRegion", fields: [regionId], references: [id])

  statusId       String
  status         LookupValue @relation("ContractStatus", fields: [statusId], references: [id])

  signingDate    DateTime?
  startDate      DateTime?
  completionDate DateTime?

  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  payments       Payment[]
  documents      Document[]
  amendments     ContractAmendment[]
  securities     ContractSecurity[]
  milestones     ContractMilestone[]

  @@index([activityId])
  @@index([supplierId])
  @@index([currencyId])
  @@index([regionId])
  @@index([statusId])
  @@index([completionDate])
}

model ContractAmendment {
  id             String   @id @default(uuid())
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  previousAmount Decimal  @db.Decimal(14, 2)
  newAmount      Decimal  @db.Decimal(14, 2)
  reason         String

  amendedById    String
  amendedByUser  User     @relation(fields: [amendedById], references: [id])

  amendedAt      DateTime @default(now())
  isActive       Boolean  @default(true)

  @@index([contractId])
  @@index([amendedById])
}

model ContractSecurity {
  id          String      @id @default(uuid())

  contractId  String
  contract    Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)

  typeId      String
  type        LookupValue @relation("SecurityType", fields: [typeId], references: [id])

  provider    String?

  amount      Decimal     @db.Decimal(14, 2)

  currencyId  String
  currency    LookupValue @relation("SecurityCurrency", fields: [currencyId], references: [id])

  issueDate   DateTime?
  expiryDate  DateTime?

  statusId    String
  status      LookupValue @relation("SecurityStatus", fields: [statusId], references: [id])

  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  @@index([contractId])
  @@index([typeId])
  @@index([currencyId])
  @@index([statusId])
  @@index([expiryDate])
}

model ContractMilestone {
  id            String      @id @default(uuid())

  contractId    String
  contract      Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)

  name          String
  dueDate       DateTime?
  deliveredDate DateTime?

  statusId      String
  status        LookupValue @relation("MilestoneStatus", fields: [statusId], references: [id])

  remarks       String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([contractId])
  @@index([statusId])
  @@index([dueDate])
}

model Payment {
  id             String      @id @default(uuid())

  contractId     String
  contract       Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)

  typeId         String
  type           LookupValue @relation("PaymentType", fields: [typeId], references: [id])

  amount         Decimal     @db.Decimal(14, 2)

  requestDate    DateTime?
  paymentDate    DateTime?

  statusId       String
  status         LookupValue @relation("PaymentStatus", fields: [statusId], references: [id])

  idempotencyKey String?     @unique

  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  @@index([contractId])
  @@index([typeId])
  @@index([statusId])
  @@index([paymentDate])
}

model Document {
  id           String         @id @default(uuid())

  entityType   String
  entityId     String

  activityId   String?
  activity     Activity?      @relation(fields: [activityId], references: [id])

  stageId      String?
  stage        ActivityStage? @relation(fields: [stageId], references: [id])

  contractId   String?
  contract     Contract?      @relation(fields: [contractId], references: [id])

  title        String
  type         String
  filename     String
  path         String

  uploadedById String
  uploader     User           @relation(fields: [uploadedById], references: [id])

  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([activityId])
  @@index([stageId])
  @@index([contractId])
  @@index([type])
  @@index([uploadedById])
}

model Comment {
  id         String   @id @default(uuid())

  entityType String
  entityId   String

  authorId   String
  author     User     @relation(fields: [authorId], references: [id])

  body       String

  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([authorId])
}

model Revision {
  id          String   @id @default(uuid())

  entityType  String
  entityId    String
  field       String
  oldValue    String?
  newValue    String?
  reason      String

  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])

  changedAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([changedById])
  @@index([changedAt])
}

model Alert {
  id             String      @id @default(uuid())

  entityTypeId   String
  entityType     LookupValue @relation("AlertEntityType", fields: [entityTypeId], references: [id])

  entityId       String

  typeId         String
  type           LookupValue @relation("AlertType", fields: [typeId], references: [id])

  severityId     String
  severity       LookupValue @relation("AlertSeverity", fields: [severityId], references: [id])

  message        String
  dueDate        DateTime?

  statusId       String
  status         LookupValue @relation("AlertStatus", fields: [statusId], references: [id])

  resolvedById   String?
  resolvedByUser User?       @relation(fields: [resolvedById], references: [id])
  resolvedAt     DateTime?

  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  @@index([entityTypeId, entityId])
  @@index([typeId])
  @@index([severityId])
  @@index([statusId])
  @@index([resolvedById])
  @@index([dueDate])
}

model AuthAuditLog {
  id        String   @id @default(uuid())
  event     String
  success   Boolean
  email     String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
}


model ImportBatch {
  id           String       @id @default(uuid())

  entityType   String
  filename     String

  uploadedById String
  uploader     User         @relation(fields: [uploadedById], references: [id])

  status       ImportStatus @default(Processing)

  totalRows    Int          @default(0)
  successCount Int          @default(0)
  errorCount   Int          @default(0)

  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  rows         ImportRow[]

  @@index([status])
  @@index([uploadedById])
  @@index([createdAt])
}

model ImportRow {
  id              String      @id @default(uuid())

  batchId         String
  batch           ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  rowNumber       Int
  success         Boolean
  errorMessage    String?
  createdEntityId String?

  @@index([batchId])
  @@index([success])
}
