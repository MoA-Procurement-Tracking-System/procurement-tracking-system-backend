model Payment {
  id String @id @default(uuid())

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  typeId String?
  type   LookupValue? @relation("PaymentType", fields: [typeId], references: [id])

  amount Decimal @db.Decimal(15, 2)

  requestDate DateTime?
  paymentDate DateTime?
  referenceNo String?

  status       PaymentStatus @default(PENDING)
  statusId     String?
  statusLookup LookupValue?  @relation("PaymentStatus", fields: [statusId], references: [id])

  idempotencyKey String? @unique

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([contractId])
  @@index([typeId])
  @@index([statusId])
  @@index([paymentDate])
}
